# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://school:school_pass123@localhost:3306/school_management"

# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=""

PORT=3000

# Comma-separated list of frontend origins allowed to call the API (cookies require an explicit origin)
CORS_ORIGIN="http://localhost:5173"

# Access token lifetime and refresh cookie lifetime
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Set to true when the API runs behind a reverse proxy such as nginx
TRUST_PROXY=false

# Login throttling: failed attempts per IP + email within the window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# bcrypt cost factor (10-15)
BCRYPT_ROUNDS=12
